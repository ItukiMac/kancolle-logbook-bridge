{
  "manifest_version": 3,
  "name": "KLB - KanColle Logbook Bridge",
  "version": "1.0.0",
  "description": "艦これ通信をCDPで航海日誌改へ直接渡し、Chrome/航海日誌間の接続不良も相互監視して通知します。",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8891/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_title": "KLB",
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  }
}

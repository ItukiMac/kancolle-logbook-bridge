{
  "manifest_version": 3,
  "name": "艦これ CDP → 航海日誌改 Direct Bridge",
  "version": "0.4.2",
  "description": "艦これの/kcsapi/とMessageFlow互換の/kcs2/画像・JSONをCDPで取得し、localhostの航海日誌改プラグインへ直接渡します。",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8891/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "艦これ Direct Bridge",
    "default_popup": "popup.html"
  }
}
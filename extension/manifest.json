{
  "manifest_version": 3,
  "name": "艦これ CDP → 航海日誌改 Direct Bridge",
  "version": "0.5.1",
  "description": "艦これ通信をCDPで航海日誌改へ直接渡し、Chrome/航海日誌間の接続不良も相互監視して通知します。",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8891/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "艦これ Direct Bridge",
    "default_popup": "popup.html"
  }
}
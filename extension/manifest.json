{
  "manifest_version": 3,
  "name": "KLB Chrome Extension",
  "version": "1.0.0",
  "description": "KLBのChrome側コンポーネント。艦これ通信をKLB Logbook Pluginへ直接渡し、接続状態を監視します。",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:8891/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_title": "KLB Chrome Extension",
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  }
}
